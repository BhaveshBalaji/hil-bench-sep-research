#!/usr/bin/env python3
"""checklist_status — show all checklist items with their status."""

import json, os, sys
from pathlib import Path

def _path() -> Path:
    task_id = (os.environ.get("TASK_INSTANCE_ID") or os.environ.get("SWE_INSTANCE_ID", "default")).split("__")[0]
    base = os.environ.get("LEDGER_BASE_PATH", "/tmp/hil_checklist")
    p = Path(base) / task_id / "checklist.json"
    p.parent.mkdir(parents=True, exist_ok=True)
    return p

def _load():
    p = _path()
    if p.exists():
        try: return json.loads(p.read_text())
        except: pass
    return {"items": [], "next_id": 1}

if __name__ == "__main__":
    d = _load()
    items = d["items"]
    if not items:
        print("Checklist is empty. Use checklist_add to register ambiguities.")
        sys.exit(0)
    resolved = sum(1 for i in items if i["status"] == "resolved")
    pending  = len(items) - resolved
    print(f"CHECKLIST — {resolved}/{len(items)} resolved, {pending} pending")
    print("=" * 55)
    for item in items:
        icon = "[✓]" if item["status"] == "resolved" else "[ ]"
        print(f"  {icon} {item['id']}: {item['description']}")
    print("=" * 55)
    if pending:
        print(f"ACTION: {pending} item(s) still pending. Resolve before submitting.")
    else:
        print("All items resolved. Safe to submit.")

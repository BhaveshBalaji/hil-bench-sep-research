#!/usr/bin/env python3
"""checklist_pending — show only unresolved checklist items."""

import json, os, sys
from pathlib import Path

def _path() -> Path:
    task_id = (os.environ.get("TASK_INSTANCE_ID") or os.environ.get("SWE_INSTANCE_ID", "default")).split("__")[0]
    base = os.environ.get("LEDGER_BASE_PATH", "/tmp/hil_checklist")
    p = Path(base) / task_id / "checklist.json"
    p.parent.mkdir(parents=True, exist_ok=True)
    return p

def _load():
    p = _path()
    if p.exists():
        try: return json.loads(p.read_text())
        except: pass
    return {"items": [], "next_id": 1}

if __name__ == "__main__":
    d = _load()
    pending = [i for i in d["items"] if i["status"] == "pending"]
    if not pending:
        print("No pending items. All ambiguities resolved — safe to submit.")
        sys.exit(0)
    print(f"PENDING AMBIGUITIES ({len(pending)}) — resolve before submitting:")
    print("=" * 55)
    for item in pending:
        print(f"  [ ] {item['id']}: {item['description']}")
    print("=" * 55)

#!/usr/bin/env python3
"""checklist_done <id> — mark a checklist item as resolved."""

import json, os, sys
from pathlib import Path

def _path() -> Path:
    task_id = (os.environ.get("TASK_INSTANCE_ID") or os.environ.get("SWE_INSTANCE_ID", "default")).split("__")[0]
    base = os.environ.get("LEDGER_BASE_PATH", "/tmp/hil_checklist")
    p = Path(base) / task_id / "checklist.json"
    p.parent.mkdir(parents=True, exist_ok=True)
    return p

def _load():
    p = _path()
    if p.exists():
        try: return json.loads(p.read_text())
        except: pass
    return {"items": [], "next_id": 1}

def _save(d):
    p = _path()
    tmp = p.with_suffix(".tmp")
    tmp.write_text(json.dumps(d, indent=2))
    tmp.replace(p)

if __name__ == "__main__":
    aid = " ".join(sys.argv[1:]).strip().upper()
    if not aid:
        print("Error: ID required. Example: checklist_done A1")
        sys.exit(1)
    d = _load()
    for item in d["items"]:
        if item["id"].upper() == aid:
            item["status"] = "resolved"
            _save(d)
            print(f"[✓] {aid} resolved: {item['description']}")
            sys.exit(0)
    print(f"Error: ID '{aid}' not found. Use checklist_status to see all IDs.")
    sys.exit(1)

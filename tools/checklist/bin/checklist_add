#!/usr/bin/env python3
"""checklist_add <description> — add a new ambiguity to the persistent checklist."""

import json, os, sys
from pathlib import Path

def _path() -> Path:
    task_id = (os.environ.get("TASK_INSTANCE_ID") or os.environ.get("SWE_INSTANCE_ID", "default")).split("__")[0]
    base = os.environ.get("LEDGER_BASE_PATH", "/tmp/hil_checklist")
    p = Path(base) / task_id / "checklist.json"
    p.parent.mkdir(parents=True, exist_ok=True)
    return p

def _load():
    p = _path()
    if p.exists():
        try: return json.loads(p.read_text())
        except: pass
    return {"items": [], "next_id": 1}

def _save(d):
    p = _path()
    tmp = p.with_suffix(".tmp")
    tmp.write_text(json.dumps(d, indent=2))
    tmp.replace(p)

if __name__ == "__main__":
    desc = " ".join(sys.argv[1:]).strip().strip("'\"")
    if not desc:
        print("Error: description cannot be empty.")
        sys.exit(1)
    d = _load()
    aid = f"A{d['next_id']}"
    d["next_id"] += 1
    d["items"].append({"id": aid, "description": desc, "status": "pending"})
    _save(d)
    print(f"Added [{aid}]: {desc}")
    print(f"Resolve this ambiguity, then call: checklist_done {aid}")
